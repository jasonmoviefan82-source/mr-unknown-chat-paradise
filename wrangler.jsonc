{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mr-unknown-chat-paradise",
  "main": "worker.js",
  "compatibility_date": "2026-11-07",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOMS",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
